# Copier ce fichier vers .env puis adapter les valeurs
DATABASE_URL="postgresql://postgres:CHANGE_ME@127.0.0.1:5433/stockflow?schema=public"
JWT_SECRET="changez-cette-cle-en-production"
JWT_EXPIRES_IN="7d"
PORT=4000
CLIENT_URL="http://localhost:5173"
CLIENT_ORIGINS="http://localhost:5173,http://127.0.0.1:5173"

# Notifications par email (laisser SMTP_HOST vide pour le mode aperçu en console)
SMTP_HOST=""
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="StockFlow <no-reply@stockflow.local>"
NOTIFY_EMAILS=""
DAILY_REPORT_CRON="0 20 * * *"
